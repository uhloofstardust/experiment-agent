# Copy this file to .env and fill in your values.

# If OPENAI_API_KEY is unset (or MOCK_MODE=true), the system runs in mock
# mode: a deterministic policy drives the same tools with no API calls.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional: point at any OpenAI-compatible endpoint (e.g. a local server).
OPENAI_BASE_URL=

# Force mock mode even if OPENAI_API_KEY is set.
MOCK_MODE=false
